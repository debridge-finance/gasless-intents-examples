        },
        "rescue(address,address,uint256)": {
          "notice": "Recover tokens held by the contract."
        },
        "revokeIntent(bytes32)": {
          "notice": "Revoke a previously submitted intent."
        },
        "revokeIntentsUpTo(uint256)": {
          "notice": "Bulk revocation: nullifies every intent from this contract with         `intentTimestamp <= timestamp`."
        },
        "submitIntent((uint32,address,(bytes,uint32[],bool)[],(address,uint256,uint256,uint256)[],(address,address,uint256,uint8)[],(address,uint32,bytes,uint256,uint8)[],uint64,uint64,address[],bytes,bool,bytes,bytes32,bytes,address,(bytes,uint32[],bool)[],address))": {
          "notice": "Validate and submit the intent; returns its id. Grants the         AllowanceHolder a one-time max approval per input token (skipped         when the allowance already covers the budget), so submission is         a single transaction."
