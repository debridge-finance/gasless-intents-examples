# The only value you need to set:
HL_PRIVATE_KEY=insert-your-private-key

# Required only to deposit FROM Solana (source-side signing). Leave blank otherwise.
HL_SOLANA_PRIVATE_KEY=


# Everything below is a working default already built into the tool — you do NOT
# need to set any of it. Uncomment a line only if you want to override a default.
# HL_API_BASE_URL=https://hl-spike.debridge.finance
# HL_EXPLORER_API_URL=https://api-gaslessb2b.debridge.finance/v1/explorer
# GASLESS_API_URL=https://deswap.debridge.finance/v1.0/bundle
# HL_HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm
# HL_ESCROW_FACTORY=0xAd635f04134562D58B30C93676FBBdF37f5c6dAB
# HL_MAX_OPEX_RESERVE=1.15
# HL_POLL_INTERVAL_MS=3000
# HL_POLL_TIMEOUT_MS=600000
# HL_DEVIATION_ALERT_BPS=50
# HL_WITHDRAW_POLL_TIMEOUT_MS=1200000
# HL_CORE_DEBIT_TOLERANCE_BPS=200
# HL_CORE_DEBIT_TOLERANCE_USD=1
# HL_SOLANA_RECIPIENT=
# GASLESS_REFRESH_SOLANA_TX_URL=

# Optional per-chain source-RPC override (public defaults ship built in), keyed by chainId:
# HL_RPC_42161=https://your-arbitrum-node
# HL_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
